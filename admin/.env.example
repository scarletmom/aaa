PORT=5678
# Shown in the dashboard sidebar and on the sign-in page.
SITE_NAME=My website
# Basic auth for the editor and /api. Leave blank only on a trusted machine.
ADMIN_USER=admin
ADMIN_PASSWORD=EKv&bU7E6
# Required by /hook/* and /resolve when set (send as "Authorization: Bearer <token>" or "x-api-key").
API_TOKEN=
# DATA_DIR=./data

# ---- the website (link-gate) ----
# Same database variables as link-gate's server; copy those lines over unchanged.
DATABASE_URL=
# MYSQL_HOST= / MYSQL_PORT= / MYSQL_USER= / MYSQL_PASSWORD= / MYSQL_DATABASE=  (instead of DATABASE_URL)
MYSQL_CA_CERT=
# MYSQL_SSL=false
# The videos site, for the View links on posts (/watch.html?v=<tag>), e.g. https://videos.example.com
SITE_URL=
# ---- workflow steps ----
# ffmpeg/ffprobe for Save File (.m3u8 → mp4) and Extract Frames. Defaults to the ones on PATH.
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
# Variables starting with WF_ are readable in workflow expressions as {{ $env.WF_NAME }}; nothing else is.
# Prefer the Variables page: values there are encrypted in the database and change without a restart.

# Encrypts the values saved on the Variables page. Keep it out of the database and use a different one
# per server. If it's lost or changed, saved values can't be read and must be entered again.
# Generate one with: openssl rand -base64 32
SECRETS_KEY=
