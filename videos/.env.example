SITE_NAME=Quillwood Video
SITE_TAGLINE=Short films, clips and streams
# The server's PUBLIC_URL.
API_URL=https://api.example.com
# Leave empty to hide the Telegram button.
TELEGRAM_URL=
# Cloudflare Turnstile sitekey (public). Must match the server's TURNSTILE_SITEKEY.
TURNSTILE_SITEKEY=1x00000000000000000000AA
# The blogsite (Next.js). The watch page's play button sends visitors here with their pass to create a Member Lite account.
BLOGSITE_URL=https://blog.example.com
