# The video server (its PUBLIC_URL). Defaults to apiUrl in src/data/site.json.
NEXT_PUBLIC_API_URL=
# Turnstile sitekey; must match the server's TURNSTILE_SITEKEY. Defaults to the server's /api/config.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Public key that checks Member Pro ad-free passes, from `npm run ad-free-key` in server/. Dev only;
# production builds read adFreeKey in src/data/site.json (the static player reads it there too).
NEXT_PUBLIC_AD_FREE_KEY=
