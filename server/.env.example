PORT=3000
NODE_ENV=development

# At least 32 characters in production. Signs the captcha pass, gate and play tokens.
JWT_SECRET=change-me

# Keys account numbers in the database (they're stored only as HMACs). At least 32 characters in production, e.g.
# `openssl rand -hex 32`. Every server using one database needs the same value, and it must NEVER change or be lost:
# without it no account can log in. The server refuses to start if it doesn't match the one the database was keyed with.
ACCOUNT_PEPPER=

# Devices one account can be signed in on at once (default 2). Signing in on another signs out the one used least recently.
MAX_DEVICES=2

# Cloudflare Turnstile. These test keys always pass.
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
TURNSTILE_SITEKEY=1x00000000000000000000AA
# Skips the Turnstile call entirely (ignored when NODE_ENV=production).
CAPTCHA_DEV_BYPASS=false

# Same database as linkproxy; copy these lines from its .env unchanged.
DATABASE_URL=
# MYSQL_HOST= / MYSQL_PORT= / MYSQL_USER= / MYSQL_PASSWORD= / MYSQL_DATABASE=  (instead of DATABASE_URL)
MYSQL_CA_CERT=
# MYSQL_SSL=false

# Where this server is reachable from a browser; goes into the gate token's fetchurl.
PUBLIC_URL=http://localhost:3000
# The videos site: allowed to call the API, and the target of "Up next" links in the player.
VIDEOS_SITE_URL=http://localhost:4000
# The news site: its pages.json picks the gate page, and its /player/ plays the video.
NEWS_SITE_URL=http://localhost:8000

# Dodo Payments (Member Pro). Empty API key = the Upgrade buttons say payments aren't open yet.
# A dodo_live_ key talks to live.dodopayments.com, any other key to test.dodopayments.com.
DODO_API_KEY=
# Optional backup for buyers who close the tab before returning: the signing secret (whsec_…) of a Dodo webhook
# pointing at <PUBLIC_URL>/api/pro/webhook. Local testing works without it.
DODO_WEBHOOK_SECRET=
# One-time product with Pay What You Want on, minimum $0.50.
DODO_PRODUCT_ID=pdt_0NsZCAbvgSv1RYt8nSDvk

# Seconds the visitor must spend on the news page before the gate token can be exchanged.
GATE_MIN_WAIT_SECONDS=10

# Telegram Mini App fallback for streams whose host blocks other sites (no CORS).
# Direct link to the Mini App from BotFather, e.g. https://t.me/MyBot/watch. Empty = no fallback.
TELEGRAM_APP_URL=
# Optional. When set, the Mini App's requests must carry valid Telegram initData for this bot.
TELEGRAM_BOT_TOKEN=

# MaxMind GeoLite (free account): IP -> country, city and ISP for visit tracking. Empty = IP only.
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
# Where the downloaded .mmdb files go (default: server/data/geoip). Refreshed weekly.
# GEOIP_DIR=
# Days to keep visit rows before they're deleted.
VISIT_RETENTION_DAYS=90
