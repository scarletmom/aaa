PORT=3000
NODE_ENV=development

# At least 32 characters in production. Signs the captcha pass, gate and play tokens.
JWT_SECRET=change-me

# Cloudflare Turnstile. These test keys always pass.
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
TURNSTILE_SITEKEY=1x00000000000000000000AA
# Skips the Turnstile call entirely (ignored when NODE_ENV=production).
CAPTCHA_DEV_BYPASS=false

# Same database as linkproxy; copy these lines from its .env unchanged.
DATABASE_URL=
# MYSQL_HOST= / MYSQL_PORT= / MYSQL_USER= / MYSQL_PASSWORD= / MYSQL_DATABASE=  (instead of DATABASE_URL)
MYSQL_CA_CERT=
# MYSQL_SSL=false

# Where this server is reachable from a browser; goes into the gate token's fetchurl.
PUBLIC_URL=http://localhost:3000
# The videos site: allowed to call the API, and the target of "Up next" links in the player.
VIDEOS_SITE_URL=http://localhost:4000
# The news site: its pages.json picks the gate page, and its /player/ plays the video.
NEWS_SITE_URL=http://localhost:8000

# Seconds the visitor must spend on the news page before the gate token can be exchanged.
GATE_MIN_WAIT_SECONDS=10

# Telegram Mini App fallback for streams whose host blocks other sites (no CORS).
# Direct link to the Mini App from BotFather, e.g. https://t.me/MyBot/watch. Empty = no fallback.
TELEGRAM_APP_URL=
# Optional. When set, the Mini App's requests must carry valid Telegram initData for this bot.
TELEGRAM_BOT_TOKEN=
